# انسخ هذا الملف إلى .env وعدّل القيم حسب الحاجة
# Copy this file to .env and adjust the values as needed.

# منفذ خادم API (الافتراضي 4000)
# API server port (default: 4000)
PORT=4000

# سر توقيع الرموز (JWT) — غيّره إلى قيمة عشوائية قوية في الإنتاج
# JWT signing secret — set a strong random value in production
AUTH_SECRET=change-me-to-a-long-random-string

# مسار حفظ بيانات قاعدة البيانات (اختياري — الافتراضي server/.pgdata)
# Where to persist the embedded database (optional — default: server/.pgdata)
PGDATA=server/.pgdata
